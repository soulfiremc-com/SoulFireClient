{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/App.css",
    "functions": ["cn", "cva", "clsx", "twMerge"]
  },
  "ignorePatterns": [
    "index.html",
    "node_modules",
    "dist",
    "storybook-static",
    "test-results",
    "build",
    "out",
    "src/routeTree.gen.ts",
    "src/components/ui",
    "shared-modules",
    "locales",
    "src/generated"
  ]
}
