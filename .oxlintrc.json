{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/strict.json"],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "react",
    "jsx-a11y",
    "node",
    "vitest",
    "effecttsgo"
  ],
  "jsPlugins": ["@shadcn/lint", "eslint-plugin-better-tailwindcss"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "build/**",
    "dist/**",
    "dist-electron/**",
    "locales/**",
    "out/**",
    "release-artifacts/**",
    "shared-modules/**",
    "storybook-static/**",
    "test-results/**",
    "src/generated/**",
    "src/routeTree.gen.ts"
  ],
  "rules": {
    "better-tailwindcss/enforce-canonical-classes": "error",
    "better-tailwindcss/no-conflicting-classes": "error",
    "better-tailwindcss/no-deprecated-classes": "error",
    "better-tailwindcss/no-duplicate-classes": "error",
    "effecttsgo/any-unknown-in-error-context": "off",
    "effecttsgo/crypto-random-uuid-in-effect": "error",
    "effecttsgo/extends-native-error": "error",
    "effecttsgo/global-console-in-effect": "error",
    "effecttsgo/global-date-in-effect": "error",
    "effecttsgo/global-fetch-in-effect": "error",
    "effecttsgo/global-json-in-effect": "error",
    "effecttsgo/global-random-in-effect": "error",
    "effecttsgo/global-timers-in-effect": "error",
    "effecttsgo/prefer-schema-over-json": "error",
    "effecttsgo/prefer-schema-tagged-error": "error",
    "effecttsgo/process-env-in-effect": "error",
    "effecttsgo/strict-effect-provide": "off",
    "effecttsgo/unsafe-effect-type-assertion": "off",
    "effecttsgo/yield-in-call-argument": "error",
    "eslint/array-callback-return": "error",
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "eslint/logical-assignment-operators": "error",
    "eslint/max-classes-per-file": "off",
    "eslint/max-depth": "off",
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-nested-callbacks": "off",
    "eslint/no-alert": "error",
    "eslint/no-await-in-loop": "off",
    "eslint/no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "eslint/no-fallthrough": "error",
    "eslint/no-inline-comments": "off",
    "eslint/no-loop-func": "error",
    "eslint/no-negated-condition": "off",
    "eslint/no-new": "error",
    "eslint/no-param-reassign": "error",
    "eslint/no-promise-executor-return": "error",
    "eslint/no-script-url": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-shadow": "error",
    "eslint/no-throw-literal": "error",
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": ["_tag", "__entityContextMenu", "__TSR_index"]
      }
    ],
    "eslint/no-unmodified-loop-condition": "error",
    "eslint/no-useless-assignment": "error",
    "eslint/no-useless-call": "error",
    "eslint/no-warning-comments": "off",
    "eslint/object-shorthand": "error",
    "eslint/prefer-const": "error",
    "eslint/prefer-object-has-own": "error",
    "eslint/prefer-template": "error",
    "eslint/preserve-caught-error": "error",
    "eslint/require-await": "off",
    "import/max-dependencies": "off",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-named-as-default": "error",
    "import/no-named-as-default-member": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "@/lib/i18n"]
      }
    ],
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/control-has-associated-label": "error",
    "jsx-a11y/label-has-associated-control": [
      "error",
      {
        "controlComponents": ["Checkbox"]
      }
    ],
    "jsx-a11y/no-autofocus": [
      "error",
      {
        "ignoreNonDOM": true
      }
    ],
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/prefer-tag-over-role": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "oxc/no-accumulating-spread": "error",
    "oxc/no-barrel-file": "error",
    "oxc/no-map-spread": "error",
    "promise/always-return": [
      "error",
      {
        "ignoreLastCallback": true
      }
    ],
    "promise/catch-or-return": [
      "error",
      {
        "allowThen": true
      }
    ],
    "react-hooks/exhaustive-deps": "error",
    "react/button-has-type": "error",
    "react/capitalized-calls": "error",
    "react/exhaustive-effect-dependencies": "error",
    "react/hook-use-state": "error",
    "react/hooks": "error",
    "react/immutability": "error",
    "react/jsx-boolean-value": "error",
    "react/jsx-curly-brace-presence": "error",
    "react/jsx-fragments": "error",
    "react/jsx-no-constructed-context-values": "error",
    "react/jsx-no-target-blank": "error",
    "react/jsx-no-useless-fragment": "error",
    "react/memo-dependencies": "error",
    "react/no-array-index-key": "error",
    "react/no-danger": "error",
    "react/no-deriving-state-in-effects": "error",
    "react/no-object-type-as-default-prop": "error",
    "react/no-unknown-property": "error",
    "react/no-unstable-nested-components": [
      "error",
      {
        "allowAsProps": true
      }
    ],
    "react/only-export-components": "error",
    "react/purity": "error",
    "react/react-in-jsx-scope": "off",
    "react/refs": "error",
    "react/self-closing-comp": "error",
    "react/set-state-in-effect": "error",
    "react/static-components": "error",
    "react/use-memo": "error",
    "typescript/array-type": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-check": false,
        "minimumDescriptionLength": 10
      }
    ],
    "typescript/consistent-indexed-object-style": "error",
    "typescript/consistent-return": "error",
    "typescript/consistent-type-definitions": ["error", "interface"],
    "typescript/consistent-type-exports": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-extraneous-class": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "package": "node:test",
            "name": [
              "test",
              "describe",
              "it",
              "suite",
              "before",
              "after",
              "beforeEach",
              "afterEach"
            ]
          }
        ]
      }
    ],
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-misused-spread": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-unnecessary-condition": [
      "error",
      {
        "allowConstantLoopConditions": "only-allowed-literals"
      }
    ],
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-parameters": "error",
    "typescript/no-unsafe-enum-assignment": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-useless-empty-export": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-function-type": "error",
    "typescript/prefer-nullish-coalescing": [
      "error",
      {
        "ignorePrimitives": {
          "boolean": true,
          "string": true
        }
      }
    ],
    "typescript/prefer-optional-chain": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/prefer-readonly": "error",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/prefer-ts-expect-error": "error",
    "typescript/require-array-sort-compare": "error",
    "typescript/require-await": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/return-await": "error",
    "typescript/strict-boolean-expressions": "off",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/unbound-method": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "unicorn/consistent-function-scoping": "error",
    "unicorn/error-message": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "unicorn/no-array-reverse": "error",
    "unicorn/no-array-sort": "error",
    "unicorn/no-document-cookie": "error",
    "unicorn/no-negated-condition": "off",
    "unicorn/no-useless-switch-case": "off",
    "unicorn/no-useless-undefined": "off",
    "unicorn/numeric-separators-style": "error",
    "unicorn/prefer-add-event-listener": "error",
    "unicorn/prefer-array-find": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-number-coercion": "off",
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/prefer-response-static-json": "error",
    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-string-raw": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-structured-clone": "error",
    "unicorn/prefer-top-level-await": "error",
    "unicorn/switch-case-braces": "error",
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "allow": ["layout"]
      }
    ],
    "shadcn/no-inline-styles": "error",
    "shadcn/no-raw-colors": "error",
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          {
            "pattern": "^Badge$",
            "allow": [
              "layout",
              "bg-success-strong",
              "border",
              "border-background/80",
              "border-destructive/40",
              "border-success/40",
              "border-warning/40",
              "rounded-full",
              "rounded-sm",
              "rounded-xs",
              "shadow-sm",
              "spacing",
              "text-destructive",
              "text-muted-foreground",
              "text-success-emphasis",
              "text-warning-emphasis",
              "typography"
            ]
          },
          {
            "pattern": "^BreadcrumbItem$",
            "allow": ["layout", "truncate"]
          },
          {
            "pattern": "^Button$",
            "allow": [
              "layout",
              "active:bg-destructive/90",
              "bg-secondary/50",
              "border",
              "border-dashed",
              "border-l-0",
              "border-r-0",
              "border-secondary",
              "dark:bg-input/30",
              "disabled:hover:bg-transparent",
              "disabled:text-sidebar-foreground/35",
              "font-normal",
              "gap-1",
              "gap-1.5",
              "gap-2",
              "hover:bg-destructive",
              "hover:bg-secondary/70",
              "hover:bg-sidebar-accent",
              "hover:text-sidebar-accent-foreground",
              "hover:text-white",
              "opacity-50",
              "p-0",
              "px-0",
              "px-1.5",
              "px-2",
              "py-0",
              "rounded",
              "rounded-full",
              "rounded-l-md",
              "rounded-none",
              "rounded-none!",
              "rounded-r-md",
              "shadow-lg",
              "shadow-none",
              "text-balance",
              "text-inherit",
              "text-muted-foreground",
              "text-sidebar-foreground/72",
              "text-sm",
              "text-xs",
              "transition-colors"
            ]
          },
          {
            "pattern": "^Card$",
            "allow": [
              "layout",
              "border-0",
              "hover:bg-muted/50",
              "transition-colors"
            ]
          },
          {
            "pattern": "^CardContent$",
            "allow": ["layout", "spacing", "text-muted-foreground", "text-sm"]
          },
          {
            "pattern": "^CardDescription$",
            "allow": ["layout", "gap-2", "line-clamp-2", "text-destructive"]
          },
          {
            "pattern": "^CardFooter$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^CardHeader$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^CardTitle$",
            "allow": ["layout", "spacing", "typography"]
          },
          {
            "pattern": "^Checkbox$",
            "allow": ["layout", "nodrag", "nopan"]
          },
          {
            "pattern": "^CollapsibleContent$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^CollapsibleTrigger$",
            "allow": [
              "layout",
              "font-medium",
              "gap-2",
              "hover:bg-muted",
              "hover:bg-muted/50",
              "px-2",
              "px-4",
              "py-1.5",
              "py-3",
              "ring-1",
              "ring-foreground/10",
              "rounded-md",
              "rounded-xl",
              "text-sm",
              "transition-colors"
            ]
          },
          {
            "pattern": "^CredenzaBody$",
            "allow": ["layout", "spacing", "text-sm"]
          },
          {
            "pattern": "^CredenzaContent$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^CredenzaFooter$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^CredenzaTitle$",
            "allow": ["layout", "gap-2"]
          },
          {
            "pattern": "^DropdownMenuCheckboxItem$",
            "allow": ["layout", "[&_svg]:text-muted-foreground", "pl-2", "pr-8"]
          },
          {
            "pattern": "^DropdownMenuContent$",
            "allow": ["layout", "rounded-lg"]
          },
          {
            "pattern": "^DropdownMenuItem$",
            "allow": ["layout", "[&_svg]:text-muted-foreground", "pl-2"]
          },
          {
            "pattern": "^DropdownMenuLabel$",
            "allow": [
              "layout",
              "font-normal",
              "p-0",
              "text-muted-foreground",
              "text-xs",
              "truncate"
            ]
          },
          {
            "pattern": "^DropdownMenuTrigger$",
            "allow": [
              "layout",
              "[&_svg]:text-muted-foreground",
              "data-popup-open:bg-accent",
              "outline-none",
              "focus-visible:ring-1",
              "focus-visible:ring-ring",
              "gap-1.5",
              "hover:bg-accent",
              "px-2",
              "py-1.5",
              "rounded-md"
            ]
          },
          {
            "pattern": "^Editable$",
            "allow": ["layout", "gap-0"]
          },
          {
            "pattern": "^EditableArea$",
            "allow": ["layout", "nodrag", "nopan"]
          },
          {
            "pattern": "^EditableInput$",
            "allow": [
              "layout",
              "bg-transparent",
              "border-none",
              "focus-visible:ring-0",
              "font-medium",
              "font-semibold",
              "line-through",
              "p-0",
              "px-0",
              "py-0",
              "shadow-none",
              "text-black/80",
              "text-muted-foreground",
              "text-primary",
              "text-sm"
            ]
          },
          {
            "pattern": "^EditablePreview$",
            "allow": [
              "layout",
              "border-none",
              "font-medium",
              "font-semibold",
              "line-through",
              "p-0",
              "px-0",
              "py-0",
              "text-black/80",
              "text-muted-foreground",
              "text-primary",
              "text-sm",
              "truncate"
            ]
          },
          {
            "pattern": "^Empty$",
            "allow": [
              "layout",
              "bg-card",
              "border",
              "border-0",
              "p-2",
              "p-3",
              "p-4",
              "p-6",
              "px-0",
              "px-4",
              "py-8",
              "rounded-none",
              "rounded-xl"
            ]
          },
          {
            "pattern": "^EmptyHeader$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^EmptyTitle$",
            "allow": ["layout", "text-muted-foreground", "text-sm", "text-xs"]
          },
          {
            "pattern": "^Field$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^FieldDescription$",
            "allow": ["layout", "typography"]
          },
          {
            "pattern": "^FieldGroup$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^FieldLabel$",
            "allow": ["layout", "text-muted-foreground", "text-xs"]
          },
          {
            "pattern": "^FieldSet$",
            "allow": ["layout", "border", "gap-3", "gap-4", "p-3", "rounded-lg"]
          },
          {
            "pattern": "^FieldTitle$",
            "allow": ["layout", "truncate"]
          },
          {
            "pattern": "^Input$",
            "allow": [
              "layout",
              "font-medium",
              "font-mono",
              "pr-8",
              "px-1.5",
              "rounded",
              "rounded-none",
              "text-sm"
            ]
          },
          {
            "pattern": "^Item$",
            "allow": [
              "layout",
              "disabled:opacity-60",
              "hover:bg-muted",
              "p-4",
              "pl-6",
              "pr-14",
              "px-6",
              "py-4",
              "rounded-lg"
            ]
          },
          {
            "pattern": "^ItemContent$",
            "allow": ["layout", "leading-tight", "spacing", "text-base"]
          },
          {
            "pattern": "^ItemDescription$",
            "allow": ["layout", "gap-2", "line-clamp-none", "text-sm"]
          },
          {
            "pattern": "^ItemGroup$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^ItemTitle$",
            "allow": ["layout", "text-lg", "truncate"]
          },
          {
            "pattern": "^Kbd$",
            "allow": [
              "layout",
              "bg-background",
              "border",
              "font-mono",
              "font-normal",
              "opacity-60",
              "px-1.5",
              "px-2",
              "shadow-xs",
              "text-2xs",
              "text-3xs",
              "text-foreground",
              "text-sm",
              "tracking-widest"
            ]
          },
          {
            "pattern": "^PopoverContent$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^ScrollArea$",
            "allow": [
              "layout",
              "font-mono",
              "pr-2",
              "pr-4",
              "rounded-md",
              "text-xs"
            ]
          },
          {
            "pattern": "^SelectContent$",
            "allow": ["layout", "lowercase"]
          },
          {
            "pattern": "^SelectItem$",
            "allow": ["layout", "lowercase"]
          },
          {
            "pattern": "^SelectTrigger$",
            "allow": [
              "layout",
              "bg-transparent",
              "border-r-0",
              "lowercase",
              "px-1.5",
              "px-2.5",
              "py-0.5",
              "rounded",
              "rounded-none"
            ]
          },
          {
            "pattern": "^Separator$",
            "allow": [
              "layout",
              "bg-border",
              "focus-visible:outline-none",
              "focus-visible:ring-1",
              "focus-visible:ring-offset-1",
              "focus-visible:ring-ring"
            ]
          },
          {
            "pattern": "^SheetContent$",
            "allow": ["layout", "p-0"]
          },
          {
            "pattern": "^SidebarMenuButton$",
            "allow": [
              "layout",
              "data-[state=open]:bg-sidebar-accent",
              "data-[state=open]:text-sidebar-accent-foreground"
            ]
          },
          {
            "pattern": "^Skeleton$",
            "allow": [
              "layout",
              "border-dashed",
              "rounded",
              "rounded-full",
              "rounded-lg",
              "rounded-md"
            ]
          },
          {
            "pattern": "^SortableContent$",
            "allow": ["layout", "gap-1.5", "gap-2", "p-1"]
          },
          {
            "pattern": "^SortableItem$",
            "allow": ["layout", "gap-2", "nodrag", "nopan"]
          },
          {
            "pattern": "^SortableItemHandle$",
            "allow": [
              "layout",
              "border",
              "border-border/60",
              "hover:bg-muted",
              "hover:text-foreground",
              "nodrag",
              "nopan",
              "rounded",
              "text-muted-foreground",
              "transition-colors"
            ]
          },
          {
            "pattern": "^TableCell$",
            "allow": ["layout", "p-0"]
          },
          {
            "pattern": "^TableRow$",
            "allow": ["layout", "hover:bg-transparent"]
          },
          {
            "pattern": "^ToggleGroup$",
            "allow": ["layout", "border", "p-2", "rounded-lg"]
          },
          {
            "pattern": "^ToggleGroupItem$",
            "allow": ["layout", "px-2", "py-1", "text-xs"]
          },
          {
            "pattern": "^TooltipContent$",
            "allow": [
              "layout",
              "bg-accent",
              "border",
              "dark:bg-card",
              "font-semibold",
              "gap-2",
              "px-2",
              "py-1",
              "text-foreground"
            ]
          },
          {
            "pattern": "^TooltipTrigger$",
            "allow": [
              "layout",
              "focus-visible:outline-(--terminal-prompt)",
              "focus-visible:outline-1",
              "focus-visible:outline-offset-1",
              "gap-1",
              "text-muted-foreground"
            ]
          }
        ]
      }
    ],
    "shadcn/no-unknown-classes": [
