          "name": "^class(?:Name)?$",
          "match": [
            {
              "type": "strings"
            }
          ]
        },
        {
          "kind": "callee",
          "name": "^cn$",
          "match": [
            {
              "type": "strings"
            },
            {
              "type": "objectKeys"
            }
          ]
        },
        {
          "kind": "callee",
          "name": "^clsx$",
          "match": [
            {
              "type": "strings"
            },
            {
              "type": "objectKeys"
            }
          ]
        },
        {
          "kind": "callee",
          "name": "^twMerge$",
          "match": [
            {
              "type": "strings"
            }
          ]
        },
        {
          "kind": "callee",
          "name": "^cva$",
          "match": [
            {
              "type": "strings"
            },
            {
              "type": "objectValues",
              "path": "^variants.*$"
            },
            {
              "type": "objectValues",
              "path": "^compoundVariants\\[\\d+\\]\\.(?:className|class)$"
            }
          ]
        },
        {
          "kind": "callee",
          "name": "^tv$",
          "match": [
            {
              "type": "strings"
            },
            {
              "type": "objectValues",
              "path": "^(?:base|variants.*|slots.*)$"
            },
            {
              "type": "objectValues",
              "path": "^compound(?:Variants|Slots)\\[\\d+\\]\\.(?:className|class).*$"
            }
          ]
        }
      ]
    }
  }
